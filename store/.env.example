# Banco Turso: libsql:// é convertido para HTTPS no servidor.
TURSO_DATABASE_URL=libsql://seu-banco-sua-org.turso.io
TURSO_AUTH_TOKEN=

# Gere valores distintos com npm run keys. Guarde a chave de criptografia.
APP_ENCRYPTION_KEY=
SETUP_TOKEN=

# Local: http://localhost:4173. Produção: URL HTTPS pública da loja.
APP_URL=http://localhost:4173
HOST=127.0.0.1
PORT=4173

# Configure marca, SMMhype, Resend e UvviPay no painel /admin.
